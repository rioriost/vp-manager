# Generated by scripts/prepare_homebrew_resources.py; edit this template.
class VpManager < Formula
  include Language::Python::Virtualenv

  desc "Resumable VOICEPEAK narration and timed presentation video production"
  homepage "https://github.com/rioriost/vp-manager"
  url "@@URL@@", using: :nounzip
  version "@@VERSION@@"
  sha256 "@@SHA256@@"
  license "MIT"

  depends_on arch: :arm64
  depends_on "ffmpeg"
  depends_on "libsndfile"
  depends_on :macos
  depends_on "poppler"
  depends_on "python@3.12"

  on_macos do
    depends_on macos: :sonoma
  end

  # Wheels already use relocatable install names. Expanding their @rpath IDs
  # can exceed native extensions' reserved Mach-O header space (e.g. tiktoken).
  preserve_rpath

@@RESOURCES@@

  def install
    ENV["PIP_NO_INDEX"] = "1"
    ENV["PIP_NO_DEPS"] = "1"
    ENV["PIP_DISABLE_PIP_VERSION_CHECK"] = "1"
    ENV["PIP_CONFIG_FILE"] = File::NULL
    venv = virtualenv_create(libexec, "python3.12")
    resources.each do |resource|
      resource.stage do
        # Homebrew's Resource helper only recognizes pure wheels; pass the
        # actual file explicitly so native wheels also install without a build.
        wheels = Pathname.pwd.glob("*.whl")
        odie "Expected exactly one wheel for #{resource.name}" if wheels.length != 1
        venv.pip_install wheels.first, build_isolation: false
      end
    end
    venv.pip_install buildpath/"vp_manager-#{version}-py3-none-any.whl", build_isolation: false
    bin.install_symlink libexec/"bin/vp-manager"
  end

  def caveats
    <<~EOS
      Requires your separately installed and activated VOICEPEAK application.
      Local ASR support is included; supply an existing model directory with
      --asr-model. No speech models or VOICEPEAK assets are downloaded here.
      PDF rendering uses Poppler. PPTX-to-PDF requires an explicit supported
      LibreOffice path or a PDF containing every slide, including hidden slides.
      Run `vp-manager install-skill --dry-run --json` to inspect Skill setup.
      Skill installation is explicit: `vp-manager install-skill --json`.
    EOS
  end

  test do
    assert_match version.to_s, shell_output("#{bin}/vp-manager --version")
    assert_match "install-skill", shell_output("#{bin}/vp-manager --help")
    (testpath/"check.py").write <<~PYTHON
      import importlib.util
      import json
      from importlib import resources
      from pathlib import Path
      import numpy as np
      import soundfile as sf
      from vp_manager.qa import inspect_audio
      from vp_manager.skill_install import install_skill

      root = resources.files("vp_manager").joinpath("bundled", "voicepeak-production")
      assert root.joinpath("skills", "voicepeak-production", "SKILL.md").is_file()
      isolated_home = Path("skill-home")
      install_skill(home=isolated_home, dry_run=True)
      assert not isolated_home.exists()
      assert importlib.util.find_spec("mlx_whisper") is not None
      rate = 24000
      signal = 0.2 * np.sin(2 * np.pi * 440 * np.arange(rate) / rate) * np.hanning(rate)
      sf.write("sample.wav", signal, rate, subtype="PCM_16")
      result = inspect_audio(Path("sample.wav"))
      assert result["status"] == "pass", result
      assert result["frames"] == rate
      print(json.dumps(result))
    PYTHON
    system libexec/"bin/python", testpath/"check.py"
    system bin/"vp-manager", "--executable", testpath/"absent-engine",
           "--settings", testpath/"empty-settings", "analyze",
           "--text", "桜餅を確認します。", "--job", testpath/"job", "--json"
    assert_path_exists testpath/"job/job.json"
  end
end
